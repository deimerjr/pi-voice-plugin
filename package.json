{
  "name": "pi-voice-plugin",
  "version": "1.1.0",
  "description": "Universal AI Text-to-Speech plugin for Pi CLI (OpenAI, ElevenLabs, compatible APIs)",
  "homepage": "https://deimerjr.github.io/pi-voice-plugin/",
  "repository": {
    "type": "git",
    "url": "https://github.com/deimerjr/pi-voice-plugin.git"
  },
  "type": "module",
  "main": "./src/index.ts",
  "keywords": [
    "pi-package",
    "tts",
    "voice",
    "speech",
    "openai",
    "elevenlabs"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test 'src/**/*.test.ts'",
    "serve:landing": "python3 -m http.server 3000 --bind 0.0.0.0 --directory landing",
    "tunnel": "cloudflared tunnel --url http://127.0.0.1:3000",
    "deploy:surge": "npx surge landing gentle-pi-voice.surge.sh"
  },
  "files": [
    "src",
    "extensions"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "license": "MIT"
}
